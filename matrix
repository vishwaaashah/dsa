#include<stdio.h>
int main()
{
	int a[3][3];
	int i, j;

	printf("Enter the elements of the 3 x 3 matrix : \n");

	for (i = 0;i < 3;i++)
	{
		for (j = 0;j < 3;j++)
		{
			printf("Enter element a[%d][%d] : ", i, j);
			scanf_s("%d", &a[i][j]);
		}
	}
	printf("\n The Matrix is : \n");

	for (int i = 0;i < 3;i++)
	{
		for (int j = 0;j < 3;j++)
		{
			printf(" %d ", i + j);
		}
		printf("\n");
	}

	return 0;
}
