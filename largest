#include<stdio.h>

int main()
{
	int i, largest, a[5];
		for (i = 0;i < 5;i++)
		{
			printf("Enter the element %d: ", i + 1);
			scanf_s("%d", &a[i]);
		}
	largest = a[0];
		for (i = 1;i < 5;i++)
		{
			if (a[i] > largest)
			{
				largest = a[i];
			}
		}
	printf("\nThe largest element is: %d\n", largest);
	return 0;
}
