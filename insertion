#include <stdio.h>
#define SIZE 10
int main()
{
	int arr[SIZE] = { 1,11,21,31,41,51,61,0,0,0 };
	int i, pos, val;

	printf("Values in array: \n");

	for (i = 0; i < SIZE && arr[i] != 0; i++)
		printf("%d", arr[i]);

	printf("\n Enter position:");
	scanf_s("%d", &pos);
	printf("\n Enter value: ");
	scanf_s("%d", &val);
	for (i = SIZE - 1;i > pos;i--)
	{
		arr[i] = arr[i - 1];
	}
	arr[pos] = val;
	printf("\n After insertion:");
	for (i = 0;i < SIZE && arr[i] != 0; i++)
		printf("%d", arr[i]);
	return 0;
}
